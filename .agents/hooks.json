{
  "corp-pipeline-orchestrator": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "py orchestration/hooks/run_hook.py session_start",
        "timeout": 15
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "py orchestration/hooks/run_hook.py proactive_advisor",
        "timeout": 15
      }
    ],
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "py orchestration/hooks/run_hook.py pre_tool_security_guard",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "py orchestration/hooks/run_hook.py post_tool_auto_healer",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "py orchestration/hooks/run_hook.py session_turnover_gate",
        "timeout": 15
      }
    ]
  }
}
